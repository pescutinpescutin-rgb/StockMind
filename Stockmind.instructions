"""StockMind application services."""
import sqlite3
from pathlib import Path

DB_PATH = Path(__file__).resolve().parent.parent / "stockmind.db"


def _connect():
    conn = sqlite3.connect(DB_PATH)
    conn.execute(
        "CREATE TABLE IF NOT EXISTS watchlist "
        "(symbol TEXT PRIMARY KEY, added_at TEXT DEFAULT CURRENT_TIMESTAMP)"
    )
    return conn


def get_watchlist():
    with _connect() as conn:
        return [
            row[0]
            for row in conn.execute(
                "SELECT symbol FROM watchlist ORDER BY added_at DESC"
            )
        ]


def add_ticker(symbol):
    with _connect() as conn:
        conn.execute(
            "INSERT OR IGNORE INTO watchlist(symbol) VALUES (?)",
            (symbol.upper(),),
        )


def remove_ticker(symbol):
    with _connect() as conn:
        conn.execute(
            "DELETE FROM watchlist WHERE symbol = ?",
            (symbol.upper(),),
        )
